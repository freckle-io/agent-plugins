{
  "name": "freckle",
  "description": "Build with Freckle in your coding agent — AI-powered list building, enrichment, lead scoring, and saved Workflows through agent skills and the freckle CLI.",
  "version": "1.0.335",
  "author": {
    "name": "Freckle",
    "url": "https://freckle.io"
  },
  "homepage": "https://freckle.io",
  "repository": "https://github.com/freckle-io/agent-plugins",
  "license": "MIT",
  "keywords": [
    "freckle",
    "lead-enrichment",
    "lead-scoring",
    "list-building",
    "prospecting",
    "sales",
    "gtm",
    "b2b-data",
    "workflows",
    "cli"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/approve-cli.sh claude"
          }
        ]
      },
      {
        "matcher": "Skill|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/approve-skills.sh claude"
          }
        ]
      }
    ]
  }
}
