{
  "name": "freckle",
  "description": "Use Freckle to build and run GTM workflows: find the companies and people you want, enrich them with the data you're missing, and send the results to the tools your team works in.",
  "version": "1.0.360+plugin.1",
  "author": {
    "name": "Freckle"
  },
  "homepage": "https://freckle.io",
  "repository": "https://github.com/freckle-io/agent-plugins",
  "license": "MIT",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/approve-cli.sh claude"
          }
        ]
      },
      {
        "matcher": "Skill|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/approve-skills.sh claude"
          }
        ]
      }
    ]
  }
}
